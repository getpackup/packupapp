{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node $PWD/hooks/read_hook.js"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -l -c 'pnpm lint' || exit 2"
          },
          {
            "type": "command",
            "command": "bash -l -c 'pnpm typecheck' || exit 2"
          }
        ]
      }
    ]
  }
}
